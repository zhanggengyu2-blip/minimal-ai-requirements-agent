APP_NAME=极简AI团队需求管理智能体
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# 相对路径固定以 backend 为基准，不受启动命令所在目录影响
DATABASE_URL=sqlite:///./data/requirements.db

# V3.0 身份与会话。正式环境必须替换为独立的高强度随机值。
SHARED_PASSWORD=
AUTH_HMAC_KEY=
INVITATION_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=team_session
# HTTPS 正式环境必须设为 true；本地 HTTP 开发保持 false
SESSION_COOKIE_SECURE=false
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_ENABLED=true

# Dify Workflow API，例如 http://127.0.0.1/v1
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=app-your-workflow-api-key
DIFY_WORKFLOW_PATH=/workflows/run
DIFY_TIMEOUT_SECONDS=8
DIFY_CANDIDATE_LIMIT=30

# V2.0 对话式需求访谈 Workflow，使用独立的应用 API Key
DIFY_INTERVIEW_API_KEY=app-your-interview-workflow-api-key
DIFY_INTERVIEW_WORKFLOW_PATH=/workflows/run
DIFY_INTERVIEW_TIMEOUT_SECONDS=8
DIFY_INTERVIEW_PROMPT_VERSION=interview-prompt-v2.0.1-image
DIFY_INTERVIEW_IMAGE_INPUT_NAME=images

# V2.0 访谈图片上传
# 相对路径固定以 backend 为基准
INTERVIEW_IMAGE_STORAGE_DIR=./data/uploads/interviews
INTERVIEW_IMAGE_MAX_BYTES=10485760
INTERVIEW_IMAGE_MAX_COUNT=5
