APP_NAME=Coo 企业 AI 协作系统 V4.0
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# 相对路径以 backend 为基准。升级已有库前先备份 data/。
DATABASE_URL=sqlite:///./data/requirements.db

# 延续 V3 的账号、管理员、项目成员与会话机制。首次运行自行设置随机值。
SHARED_PASSWORD=
AUTH_HMAC_KEY=
INVITATION_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=team_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_ENABLED=true

# Coo：兼容 OpenAI Chat Completions + Tool Calling + JSON 输出的服务。
# Base URL 包含 /v1 等供应商要求的前缀；程序追加 /chat/completions。
COO_BASE_URL=https://api.openai.com/v1
COO_API_KEY=
COO_MODEL=
COO_TIMEOUT_SECONDS=30
COO_RUN_TIMEOUT_SECONDS=90
COO_MAX_ROUNDS=6
COO_MAX_OUTPUT_TOKENS=1500
COO_TOKEN_BUDGET=96000
COO_CONTEXT_CHARS=18000
COO_CANDIDATE_LIMIT=30
COO_EVENT_POLL_SECONDS=2
COO_EVENT_MAX_ATTEMPTS=5

# Embedding（向量模型）：程序追加 /embeddings，接口须返回 index 与 embedding。
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=

# Rerank（重排序模型，可选）：标准 /rerank 接口，返回 results/index/relevance_score。
# 留空时按 RRF 排序，界面会显示降级说明，不能将其当作 Rerank 相关度。
KNOWLEDGE_RERANK_BASE_URL=
KNOWLEDGE_RERANK_API_KEY=
KNOWLEDGE_RERANK_MODEL=
# standard 使用 /rerank；dashscope 沿用参考工程的原生 text-rerank 接口，Base URL 填服务域名。
KNOWLEDGE_RERANK_FORMAT=standard

# V4 不需要 Dify 配置。旧 Dify/访谈代码与配置字段仅为历史恢复保留。
